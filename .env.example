# ==============================================================
# website-gateway-service — configuration template
# Port: 55590 (external) -> 8080 (internal)
# Stateless — нет БД. Получает конфиг через polling control-plane.
# ==============================================================

# === Upstream services ===
CONTROL_PLANE_URL=http://45.144.55.73:55580
AI_AGENT_SERVICE_URL=http://45.144.55.73:55570
AI_AGENT_REQUEST_TIMEOUT_SECONDS=120

# === Internal S2S ===
# ОДИН И ТОТ ЖЕ ТОКЕН во всех S2S-сервисах.
# See ENV_DOCUMENTATION.md in chota-gateway repository for cross-service environment variables
INTERNAL_API_TOKEN=CHANGE_ME_SHARED_INTERNAL_TOKEN
CHAT_S2S_TOKEN=CHANGE_ME_DEDICATED_CHAT_TOKEN

# === Polling / runtime ===
INTEGRATIONS_POLL_INTERVAL=60
HOST=0.0.0.0
PORT=8080
ALLOWED_ORIGINS=https://chota.by
LOG_LEVEL=INFO
