# ==============================================================
# website-gateway-service — configuration template
# Port: 55590 (external) -> 8080 (internal)
# Stateless — нет БД. Получает конфиг через polling control-plane.
# ==============================================================

# === Upstream services ===
CONTROL_PLANE_URL=http://45.144.55.73:55580
AI_AGENT_SERVICE_URL=http://45.144.55.73:55570
AI_AGENT_REQUEST_TIMEOUT_SECONDS=120

# === Internal S2S ===
# ОДИН И ТОТ ЖЕ ТОКЕН во всех S2S-сервисах.
# See ENV_DOCUMENTATION.md in chota-gateway repository for cross-service environment variables
INTERNAL_API_TOKEN=CHANGE_ME_SHARED_INTERNAL_TOKEN
CHAT_S2S_TOKEN=CHANGE_ME_DEDICATED_CHAT_TOKEN

# === Polling / runtime ===
INTEGRATIONS_POLL_INTERVAL=60
HOST=0.0.0.0
PORT=8080
ALLOWED_ORIGINS=https://chota.by
LOG_LEVEL=INFO

# Managed Website: default legacy. Guards MUST be retained after admission/rollback.
MANAGED_WEBSITE_GUARDED_INTEGRATIONS={}
MANAGED_WEBSITE_COHORTS={}
CONVERSATION_SERVICE_URL=
CONVERSATION_S2S_TOKEN=
CONVERSATION_REQUEST_TIMEOUT_SECONDS=10
CONVERSATION_RESULT_WAIT_SECONDS=120
CONVERSATION_RESULT_POLL_SECONDS=0.25

# Common credential transport remains off; message admission also defaults closed.
# Select only canonical server-issued session UUIDs for exact common integrations.
# Shape: {"<integration UUID>":["<server-issued session UUID>"]}; no broad mode.
# Read at startup. Removal stops new input, not existing Turns/writers or authority.
COMMON_WEBSITE_INTEGRATIONS={}
COMMON_WEBSITE_MESSAGE_SESSION_ALLOWLIST={}

# Writer parent configuration must be exported as environment variables;
# it is intentionally not read from the gateway child's .env file.
# WRITER_ATTESTOR_SCOPES=[]
# WRITER_LEGACY_DRAIN_SCOPES=[]
# WRITER_PRODUCER_URL=http://conversation-service:8000
# WRITER_PRODUCER_TOKEN=<dedicated-scoped-secret>
